{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "https://globalgrid2050.com/schema/pipeline-news/repd-events-feed.v1.json",
 "title": "Pipeline News REPD events feed v1",
 "description": "Typed project events between two DESNZ REPD releases, each with a transparent additive relevance score. Written by automation/news/build_feed.py.",
 "type": "object",
 "required": ["schema", "tool", "release", "category", "previous", "new", "reference_date", "inputs", "profile",
              "profile_sha256", "max_score", "rules", "datacentre_join", "caveats", "counts", "event_count", "top_n", "top", "events"],
 "properties": {
  "schema": {"const": "globalgrid2050.pipeline-news.repd-events-feed.v1"},
  "tool": {"const": "automation/news/build_feed.py"},
  "release": {"type": "string", "pattern": "^[0-9]{4}q[1-4]$"},
  "category": {"const": "REPD_ENERGY_PROJECTS"},
  "lane": {"const": "REPD_EVENTS"},
  "previous": {"$ref": "#/$defs/release"},
  "new": {"$ref": "#/$defs/release"},
  "reference_date": {"type": "string", "format": "date"},
  "inputs": {"type": "array", "minItems": 2, "items": {"type": "object", "required": ["role", "file", "sha256"],
             "properties": {"sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}}},
  "profile": {"type": "object", "required": ["id"]},
  "profile_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
  "max_score": {"type": "number"},
  "datacentre_join": {"enum": ["supplied", "not supplied"]},
  "counts": {"type": "object", "additionalProperties": {"type": "integer", "minimum": 0}},
  "event_count": {"type": "integer"},
  "top_n": {"type": "integer"},
  "top": {"type": "array", "items": {"allOf": [{"$ref": "#/$defs/event"},
          {"type": "object", "required": ["top_rank", "grouped_refs"],
           "properties": {"top_rank": {"type": "integer", "minimum": 1},
                          "grouped_refs": {"type": "array", "items": {"type": "string"}}}}]}},
  "events": {"type": "array", "items": {"$ref": "#/$defs/event"}}
 },
 "$defs": {
  "release": {"type": "object", "required": ["label", "file", "bytes", "sha256", "unique_refs", "max_record_last_updated"],
              "properties": {"sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}},
  "nullable_string": {"type": ["string", "null"]},
  "nullable_number": {"type": ["number", "null"]},
  "component": {"type": "object", "required": ["name", "points", "max", "basis"],
                "properties": {"name": {"enum": ["capacity", "stage", "technology", "recency", "national_route",
                                                  "datacentre_proximity", "novelty", "evidence_tier", "colocated_storage",
                                                  "binding", "official_corroboration"]},
                               "points": {"type": "number"}, "max": {"type": "number"}, "basis": {"type": "string"}}},
  "event": {
   "type": "object",
   "required": ["event_id", "event_type", "basis", "ref", "gg_project_id", "capacity_mw", "previous_capacity_mw", "status",
                "previous_status", "site_name", "technology", "operator", "county", "region", "country",
                "planning_authority", "dates", "record_last_updated", "event_date", "event_date_source", "group_key",
                "headline", "sibling_refs_same_event", "relevance", "rank", "title", "date", "date_kind", "link", "lane", "score"],
   "properties": {
    "event_id": {"type": "string", "pattern": "^GG2050-REPDEVT-[0-9A-F]{16}$"},
    "event_type": {"enum": ["CONSENTED", "CONSTRUCTION_STARTED", "OPERATIONAL", "REFUSED", "WITHDRAWN", "APPEAL_LODGED",
                            "STATUS_REVERSAL", "DECOMMISSIONED", "LAPSED_OR_REVISED", "NEW_LARGE_APPLICATION",
                            "NEW_APPLICATION", "NEW_RECORD", "REMOVED_FROM_REGISTER", "CAPACITY_CHANGE",
                            "OPERATOR_CHANGE", "TECHNOLOGY_CHANGE"]},
    "basis": {"enum": ["transition", "new_record", "removed"]},
    "ref": {"type": "string", "pattern": "^[0-9A-Za-z-]+$"},
    "gg_project_id": {"type": "string", "pattern": "^GG2050-REPD-"},
    "capacity_mw": {"$ref": "#/$defs/nullable_number"},
    "previous_capacity_mw": {"$ref": "#/$defs/nullable_number"},
    "status": {"$ref": "#/$defs/nullable_string"},
    "previous_status": {"$ref": "#/$defs/nullable_string"},
    "site_name": {"type": "string"},
    "technology": {"$ref": "#/$defs/nullable_string"},
    "dates": {"type": "object", "additionalProperties": {"type": "string", "format": "date"}},
    "event_date": {"type": ["string", "null"], "format": "date"},
    "headline": {"type": "string", "minLength": 10, "maxLength": 400},
    "change": {"type": "object"},
    "datacentre_context": {"type": "object", "required": ["nearest", "basis"]},
    "relevance": {"type": "object", "required": ["score", "max_possible", "profile", "components"],
                  "properties": {"score": {"type": "number"}, "components": {"type": "array", "minItems": 9,
                                 "items": {"$ref": "#/$defs/component"}}}},
    "rank": {"type": "integer", "minimum": 1},
    "title": {"type": "string"},
    "date": {"type": ["string", "null"], "format": "date"},
    "date_kind": {"enum": ["milestone", "record_last_updated"]},
    "link": {"type": ["string", "null"]},
    "lane": {"const": "REPD_EVENTS"},
    "score": {"type": "number"}
   }
  }
 }
}
