    "LTD",
    "LLP",
    "Reg no",
    "company_number",
    "loading…"
   ],
   "console_errors_allowed": 0,
   "no_horizontal_overflow_at_px": 430
  },
  {
   "name": "sector-star-data",
   "targets": [
    "https://globalgrid2050.com/testcode/202609150125/data/sectors.json",
    "https://globalgrid2050.com/testcode/202609150125/data/geography.json",
    "https://globalgrid2050.com/testcode/202609150125/data/provenance.json"
   ],
   "must_contain": [
