name: REPD new-release check (report only)
# DISABLED BY DEFAULT. The ".disabled" suffix means GitHub does not register this file
# (same convention as catalogue-gridatlas-v9.yml.disabled). It is report-only: read
# permission, no checkout writes, no commit, no push, no PR, no deploy. It asks the
# gov.uk content API for the newest REPD_Publication_Q?_YYYY csv+xlsx pair and writes
# a job summary saying whether that release is one the pipeline already knows.
#
# To enable (owner only): rename this file to repd-new-release-check.yml in a PR and
# merge it. Keep only workflow_dispatch if the manual-only freeze must hold strictly;
# the weekly schedule below is the optional report-only check the freeze rule allows.
# Running 000_freeze_all_workflows_to_manual.yml later would strip the schedule again.
# When it reports a new release, dispatch "REPD release candidate (manual, draft PR only)".
on:
  workflow_dispatch:
  schedule:
    - cron: '17 7 * * 1'
permissions:
  contents: read

concurrency:
  group: repd-new-release-check
  cancel-in-progress: true

jobs:
  check:
    runs-on: ubuntu-latest
    timeout-minutes: 10
    steps:
      - name: Checkout automation only
        uses: actions/checkout@v4
        with:
          fetch-depth: 1
          filter: blob:none
          persist-credentials: false
          sparse-checkout: |
            automation

      - name: Set up Python
        uses: actions/setup-python@v5
        with:
          python-version: '3.11'

      - name: Ask the publication page (report only, never fails on a new release)
        shell: bash
        run: |
          set -euo pipefail
          python -m pip install --disable-pip-version-check 'pandas>=2,<3' 'openpyxl>=3.1,<4' >/dev/null
          python -m automation.repd.run --detect-only --out "$RUNNER_TEMP/detect" > "$RUNNER_TEMP/detect.log"
          python - "$RUNNER_TEMP/detect/detect_report.json" >> "$GITHUB_STEP_SUMMARY" <<'PY'
          import json, sys
          r = json.load(open(sys.argv[1]))
          print("## REPD new-release check")
          print()
          print(f"- Newest on gov.uk: `{r.get('label')}` (page updated {r.get('public_updated_at')})")
          print(f"- CSV: {r.get('csv_url')}")
          print(f"- XLSX: {r.get('xlsx_url')}")
          print(f"- Known releases: {', '.join(r.get('known_labels', []))}")
          print(f"- **New release: {'YES - dispatch the release candidate workflow' if r.get('new_release') else 'no'}**")
          PY
          if grep -q '"new_release": true' "$RUNNER_TEMP/detect/detect_report.json"; then
            echo "::notice::A REPD release not yet known to automation/repd is on gov.uk"
          fi
