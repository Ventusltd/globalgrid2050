{
  "schema": "globalgrid2050.v7.plugin-manifest.v1",
  "version": "9.1",
  "contract": "../contracts/plugin.v1.json",
  "plugins": [
    {
      "id": "gauges",
      "module": "scripts/plugins/gauges-v9-1.js",
      "owns": ["g1", "g2", "g3", "v1", "v2", "v3"],
      "depends_on": []
    },
    {
      "id": "newspaper",
      "module": "scripts/plugins/newspaper.js",
      "owns": ["newsMeta", "newsSearch", "newsTools", "stories"],
      "depends_on": ["gauges"]
    },
    {
      "id": "projects",
      "module": "scripts/plugins/projects-v9-1.js",
      "components": [
        "scripts/data/canonical-projects-v9-1.js",
        "data/v9.1/build_manifest.json",
        "data/v9.1/projects/*.json",
        "data/v9.1/atlas/*.geojson",
        "contracts/release.v9.1.json"
      ],
      "owns": ["county", "export", "search", "status", "tbody", "tech"],
      "depends_on": ["gauges", "newspaper"]
    }
  ]
}
