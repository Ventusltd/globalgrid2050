{
  "schema": "globalgrid2050.v7.plugin-manifest.v1",
  "version": "9.2",
  "contract": "../contracts/plugin.v1.json",
  "plugins": [
    {
      "id": "gauges",
      "module": "scripts/plugins/gauges-v9-2.js",
      "owns": ["g1", "g2", "g3", "v1", "v2", "v3"],
      "depends_on": []
    },
    {
      "id": "newspaper",
      "module": "scripts/plugins/newspaper-v9-2.js",
      "components": ["scripts/core/news-relevance-v9-2.js", "dist/major_project_news_v5.json"],
      "owns": ["newsMeta", "newsSearch", "newsTools", "stories"],
      "depends_on": ["gauges"]
    },
    {
      "id": "projects",
      "module": "scripts/plugins/projects-v9-2.js",
      "components": [
        "scripts/core/project-filter-v9-2.js",
        "scripts/data/canonical-projects-v9-2.js",
        "scripts/data/canonical-projects-v9-1.js",
        "data/v9.1/build_manifest.json",
        "data/v9.1/projects/*.json",
        "data/v9.1/atlas/*.geojson",
        "contracts/release.v9.1.json",
        "contracts/release.v9.2.json"
      ],
      "owns": ["clearFilters", "county", "export", "exportInline", "resultsMeta", "search", "status", "tbody", "tech"],
      "depends_on": ["gauges", "newspaper"]
    }
  ]
}
