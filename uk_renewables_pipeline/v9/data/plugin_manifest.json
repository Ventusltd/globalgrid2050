{
  "schema": "globalgrid2050.v7.plugin-manifest.v1",
  "version": "9.0",
  "contract": "../contracts/plugin.v1.json",
  "plugins": [
    {
      "id": "gauges",
      "module": "scripts/plugins/gauges.js",
      "owns": ["g1", "g2", "g3", "g4", "v1", "v2", "v3", "v4"],
      "depends_on": []
    },
    {
      "id": "newspaper",
      "module": "scripts/plugins/newspaper.js",
      "owns": ["newsMeta", "newsSearch", "newsTools", "stories"],
      "depends_on": ["gauges"]
    },
    {
      "id": "projects",
      "module": "scripts/plugins/projects.js",
      "components": [
        "scripts/data/canonical-projects.js",
        "scripts/core/project-state.js",
        "scripts/plugins/canonical-project-controls.js",
        "scripts/plugins/canonical-project-table.js",
        "scripts/plugins/canonical-project-export.js"
      ],
      "owns": ["county", "export", "search", "status", "tbody", "tech"],
      "depends_on": ["gauges", "newspaper"]
    }
  ]
}
