      "direct_related_repd_refs",
      "planning_sibling_repd_refs",
      "development_repd_refs"
    ],
    "relationship_object": {
      "required_fields": ["repd_ref", "type", "source_field"],
      "type_enum": ["CURRENT_VERSION", "PREVIOUS_REPD_REF", "COLOCATED_COMPONENT"],
      "out_of_scope_targets_allowed": true
    },
    "identity_rules": [
      "gg_project_id equals GG2050-REPD-{repd_ref}",
      "REPD Ref and GlobalGrid project ID are unique",
      "development_repd_refs contains the record's own REPD Ref",
      "co-located records share a development ID but remain separate project rows",
      "identity_status equals REPD_BOUND and identity_confidence equals authoritative"
